# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Alternative: SQLite for local development
# DATABASE_URL=sqlite+aiosqlite:///./bot_database.db

# Logging
LOG_LEVEL=INFO

# Web Server (for Render.com free tier)
# Render automatically sets PORT, but you can specify it for local development
PORT=8080
